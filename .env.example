NANOMDM_API_KEY=replace_with_long_random_value
# Public URL NanoMDM uses to POST device events (use https://your-domain/api/webhook on VPS)
NANOMDM_WEBHOOK_URL=https://mdm.example.com/api/webhook
JWT_SECRET=replace_with_long_random_value
JWT_EXPIRES_IN=12h
# Use /app/data/mdm.db when running via docker compose; ./data/mdm.db for local npm dev
DATABASE_URL=/app/data/mdm.db
DOMAIN=mdm.example.com
APNS_TOPIC=com.apple.mgmt.External.REPLACE_WITH_APNS_TOPIC
SCEP_URL=https://mdm.example.com/scep
SCEP_CHALLENGE=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_me
APNS_CERT_PATH=/app/certs/apns/apns.pem
APNS_KEY_PATH=/app/certs/apns/apns.key
ALLOW_DEVICE_WIPE=false
